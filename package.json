{
  "name": "@mridang/webhint-hints",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "prepack": "tsc --build",
    "test": "tsc --build && NODE_OPTIONS=--max-old-space-size=6144 jest --verbose --config=jest.config.mjs && npm test --workspace packages/web",
    "test:watch": "npm run test -- --watch",
    "test:debug": "tsc --build && jest --verbose --config=jest.config.mjs --detectOpenHandles",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "tsc --build && npx eslint . && npm run lint --workspace packages/web",
    "lint:fix": "tsc --build && npx eslint . --fix && npm run lint:fix --workspace packages/web"
  },
  "author": {
    "name": "Mridang Agarwalla",
    "email": "mridang.agarwalla@gmail.com",
    "url": "https://github.com/mridang"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mridang/webhint-hints.git"
  },
  "homepage": "https://github.com/mridang/webhint-hints",
  "bugs": "https://github.com/mridang/webhint-hints/issues",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@jest/globals": "^30.5.2",
    "@mridang/eslint-defaults": "^1.7.0",
    "@mridang/semantic-release-oci": "^1.2.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tsconfig/node22": "^22.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "jest-junit": "^16.0.0",
    "knip": "^6.42.1",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  }
}
