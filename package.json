{
  "name": "@mridang/plumbline-workspace",
  "version": "0.1.0",
  "description": "Workspace for plumbline, about 280 checks for a website and the services around it, run as webhint hints",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "tsc --build && npx eslint . && npm run lint --workspace packages/web && npm run typecheck --workspace packages/web",
    "lint:fix": "tsc --build && npx eslint . --fix && npm run lint:fix --workspace packages/web && npm run typecheck --workspace packages/web",
    "prepack": "tsc --build",
    "test": "tsc --build && npm run build:views --workspace packages/web && jest --verbose --config=jest.config.mjs",
    "test:debug": "tsc --build && npm run build:views --workspace packages/web && jest --verbose --config=jest.config.mjs --detectOpenHandles",
    "test:watch": "npm run test -- --watch"
  },
  "author": {
    "name": "Mridang Agarwalla",
    "email": "mridang.agarwalla@gmail.com",
    "url": "https://github.com/mridang"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mridang/plumbline.git"
  },
  "homepage": "https://github.com/mridang/plumbline",
  "bugs": "https://github.com/mridang/plumbline/issues",
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@jest/globals": "^30.5.2",
    "@mridang/eslint-defaults": "^2.1.0",
    "@mridang/semantic-release-oci": "^1.2.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tsconfig/node22": "^22.0.6",
    "@tsconfig/node24": "^24.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "knip": "^6.45.1",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@eslint/core": "1.2.1",
    "@hint/connector-puppeteer": {
      "puppeteer-core": "^25.16.0"
    },
    "@hint/hint-apple-touch-icons": {
      "image-size": "^2.0.3"
    },
    "@hint/hint-image-optimization-cloudinary": {
      "image-size": "^2.0.3"
    },
    "@mapbox/node-pre-gyp": {
      "tar": "^7.5.21"
    },
    "cacache": {
      "glob": "^14.0.2",
      "tar": "^7.5.21"
    },
    "filelist": {
      "minimatch": "^11.0.1"
    },
    "update-notifier": {
      "got": "^11.8.5"
    }
  }
}
