{
  "name": "@mridang/plumbline-workspace",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "tsc --build && npx eslint . && npm run lint --workspace packages/web",
    "lint:fix": "tsc --build && npx eslint . --fix && npm run lint:fix --workspace packages/web",
    "prepack": "tsc --build",
    "test": "tsc --build && jest --verbose --config=jest.config.mjs && npm test --workspace packages/web",
    "test:debug": "tsc --build && jest --verbose --config=jest.config.mjs --detectOpenHandles",
    "test:watch": "npm run test -- --watch"
  },
  "author": {
    "name": "Mridang Agarwalla",
    "email": "mridang.agarwalla@gmail.com",
    "url": "https://github.com/mridang"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mridang/plumbline.git"
  },
  "homepage": "https://github.com/mridang/plumbline",
  "bugs": "https://github.com/mridang/plumbline/issues",
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@jest/globals": "^30.5.2",
    "@mridang/eslint-defaults": "file:../../../../../../../../private/tmp/claude-501/-Users-mridang-Code-mridang-eslint-defaults--claude-worktrees-jolly-nobel-b54514/5d85ee26-5030-436a-b806-a5058404a92f/scratchpad/pack/mridang-eslint-defaults-2.0.1.tgz",
    "@mridang/semantic-release-oci": "^1.2.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tsconfig/node22": "^22.0.6",
    "@tsconfig/node24": "^24.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "knip": "^6.42.1",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3"
  },
  "overrides": {
