    "@hint/connector-puppeteer": {
      "puppeteer-core": "^25.16.0"
    },
    "@hint/hint-apple-touch-icons": {
      "image-size": "^2.0.3"
    },
    "@hint/hint-image-optimization-cloudinary": {
      "image-size": "^2.0.3"
    },
    "@mapbox/node-pre-gyp": {
      "tar": "^7.5.21"
    },
    "cacache": {
      "glob": "^14.0.2",
      "tar": "^7.5.21"
    },
    "filelist": {
      "minimatch": "^11.0.1"
    },
    "update-notifier": {
      "got": "^11.8.5"
    }
  }
