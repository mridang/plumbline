{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "plumbline",
  "main": "src/worker.ts",
  "account_id": "779037e608ab1102679ef8b1bd499d49",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Cloudflare auto-routes the Worker to the colo closest to D1
  // (avoids the worst-case ~70 ms hop). Free on all plans.
  "placement": { "mode": "smart" },
  // Wrangler's own usage telemetry for this project (anonymous CLI usage; the
  // setting overrides each developer's personal preference).
  "send_metrics": true,
  // Workers Observability, everything on at 100% (the volume is tiny and the data
  // is what debugging needs): the app's own log lines, the automatic per-request
  // invocation logs, distributed traces, and real-time Issues. Query strings are
  // stripped from the URLs in logs and traces, because they can carry search
  // text, addresses and sign-in codes.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "issues": { "enabled": true },
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
  // Custom domain — the workers.dev subdomain is disabled so the canonical URL
  // is the one we control. The apps.mrida.ng zone must be attached to this
  // Cloudflare account for the custom_domain bind to succeed.
  "workers_dev": false,
  "routes": [{ "pattern": "plumbline.apps.mrida.ng", "custom_domain": true }],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets",
  },
  // The re-check (src/domain/suite/scheduled.ts) of the sites found through
  // GitHub that have not been checked for six hours. The account is on the Workers
  // Paid plan (WORKERS_PLAN below, src/domain/suite/limits.ts), so each trigger
  // takes a bigger batch and it fires every ten minutes.
  "triggers": { "crons": ["*/10 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "plumbline-db",
      // Create with `wrangler d1 create <database_name>` and paste the id here.
      "database_id": "568b8510-43c7-46cf-b765-a0ca32cbc037",
      "migrations_dir": "migrations",
    },
  ],
  // The release id, so cached pages are keyed to the release that made them.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  // Cloudflare Workers Rate Limiting: checked in the Worker before the app
  // (src/lib/core/http/edge-limits.ts and extras.ts say which request counts
  // against which binding). Limits are per Cloudflare location and eventually
  // consistent: a cost guard, not an accounting system. namespace_id is
  // account-wide and shared by every Worker that uses the same number, hence
  // the distinctive 75xx range.
  "ratelimits": [
    // sign-in and approval flows: slow human actions
    {
      "name": "RL_AUTH",
      "namespace_id": "7509",
      "simple": { "limit": 30, "period": 60 },
    },
    // the token endpoint: assistants share egress addresses, so this is a flood guard only
    {
      "name": "RL_TOKEN",
      "namespace_id": "7510",
      "simple": { "limit": 600, "period": 60 },
    },
    // client registration (the durable per-hour limit is in D1)
    {
      "name": "RL_REGISTER",
      "namespace_id": "7511",
      "simple": { "limit": 10, "period": 60 },
    },
    // MCP requests, per bearer token
    {
      "name": "RL_MCP",
      "namespace_id": "7512",
      "simple": { "limit": 300, "period": 60 },
    },
    // MCP requests with no bearer token: probing only
    {
      "name": "RL_MCP_ANONYMOUS",
      "namespace_id": "7513",
      "simple": { "limit": 60, "period": 60 },
    },
    // pictures, per person (the app serves none, but the shared code counts them)
    {
      "name": "RL_COVER",
      "namespace_id": "7501",
      "simple": { "limit": 600, "period": 60 },
    },
    // the rest of the API, per person
    {
      "name": "RL_API",
      "namespace_id": "7502",
      "simple": { "limit": 120, "period": 60 },
    },
    // well-known documents, health and crawler files, per address
    {
      "name": "RL_DISCOVERY",
      "namespace_id": "7503",
      "simple": { "limit": 120, "period": 60 },
    },
    // browser reports (what the CSP blocked), per address: a broken page can send many
    {
      "name": "RL_REPORTS",
      "namespace_id": "7504",
      "simple": { "limit": 60, "period": 60 },
    },
    // pages, per address
    {
      "name": "RL_SITE",
      "namespace_id": "7505",
      "simple": { "limit": 300, "period": 60 },
    },
    // everything, per address: bounds callers who make up session cookies
    {
      "name": "RL_ADDRESS",
      "namespace_id": "7506",
      "simple": { "limit": 900, "period": 60 },
    },
    // scans started and run, per address: each one runs every check on the scanner container
    {
      "name": "RL_SCAN",
      "namespace_id": "7507",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  // One object per person holds the open server-sent-event streams of the
  // dashboards they have open and replays missed events from the log in D1; it
  // stores nothing itself (src/lib/cloudflare/user-hub.ts).
  "durable_objects": {
    "bindings": [
      { "name": "USER_HUB", "class_name": "UserHub" },
      // The scanner: every check of a scan runs in this container (Node, the
      // hints package and the engine, no browser) and streams its results.
      { "name": "SCANNER", "class_name": "ScannerContainer" },
      // The scanner that runs the checks in the Durable Object itself and asks
      // a small probe container only for what needs real sockets (probe/README.md).
      // SCAN_ENGINE below picks which of the two the scans use.
      { "name": "PROBE", "class_name": "ProbeScanner" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UserHub"] },
    { "tag": "v2", "new_sqlite_classes": ["ProbeContainer"] },
    { "tag": "v3", "new_sqlite_classes": ["ScannerContainer"] },
    // The TLS prober is gone: the scanner makes its own handshakes.
    { "tag": "v4", "deleted_classes": ["ProbeContainer"] },
    { "tag": "v5", "new_sqlite_classes": ["ProbeScanner"] },
  ],
  // The scanner's container. The deploy builds the image and registers it
  // through Cloudflare's containers API, so the API token needs the
  // Containers permission (Account, Containers, Edit).
  "containers": [
    {
      "class_name": "ScannerContainer",
      // The repository's Dockerfile: wrangler builds its last stage, which is
      // the scanner (the image without a browser). The build context is the
      // repository, as the Dockerfile copies every workspace.
      "image": "../../Dockerfile",
      "image_build_context": "../..",
      // 4 GiB: a scan keeps the hints package, the engine and a page in memory.
      "instance_type": "standard-1",
      // THE LIMIT ON SCANS AT ONCE: the containers that may run together.
      // Every queued job and every page scan has a scanner Durable Object of
      // its own with a container of its own, so this bounds all of them: the
      // scan queue's consumer ("queues" below) may run at most
      // QUEUE_SCAN_CONCURRENCY jobs, and the page's scans are spread over
      // INTERACTIVE_SHARDS objects (src/domain/scan/run.ts). Keep
      //   consumer max_concurrency + INTERACTIVE_SHARDS <= max_instances
      // (test/wrangler-config.test.ts holds the file to it). A start that
      // would pass this limit fails, the job is retried with a delay.
      // Containers are billed while they run (4 GiB, half a vCPU each).
      "max_instances": 10,
    },
    {
      "class_name": "ProbeScanner",
      // The probe: one static binary on an empty image (probe/Dockerfile), about
      // 5 MB, idling at a few MB of memory, so the smallest instance type is
      // enough. The checks run in the Durable Object, not here.
      "image": "../../probe/Dockerfile",
      "image_build_context": "../../probe",
      "instance_type": "lite",
      // Same rule as above for the scans that use it: the queue consumer's
      // max_concurrency + INTERACTIVE_SHARDS <= max_instances.
      "max_instances": 10,
    },
  ],
  // The scan queue (src/domain/suite/queue.ts). The GitHub webhook and the cron
  // trigger only send a message; this Worker's consumer runs each job in a
  // scanner container of its own. Create both queues once (wrangler queues
  // create plumbline-scans; plumbline-scans-dlq): see README.md.
  "queues": {
    "producers": [{ "binding": "SCAN_QUEUE", "queue": "plumbline-scans" }],
    "consumers": [
      {
        "queue": "plumbline-scans",
        // One job for each consumer invocation, which has 15 minutes of wall
        // time to itself: a repository's sites take a few minutes at most.
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        // QUEUE_SCAN_CONCURRENCY: jobs running at the same time, each in its
        // own container. 8 + the 2 page-scan objects = max_instances (10).
        "max_concurrency": 8,
        // Retries wait 30 s, 60 s, 120 s ... (domain/suite/queue.ts), then the
        // message goes to the dead-letter queue, which is logged; the job
        // itself stays in D1 and is sent again by the cron sweep.
        "max_retries": 5,
        "dead_letter_queue": "plumbline-scans-dlq",
      },
      // The dead-letter queue: its consumer only logs what ran out of retries.
      { "queue": "plumbline-scans-dlq", "max_batch_size": 10 },
    ],
  },
  "vars": {
    // The Cloudflare plan: sets the limits of the server-side checks.
    "WORKERS_PLAN": "paid",
    // Where the checks run: "container" is the scanner container (Node, the
    // hints package, every check), "worker" is the ProbeScanner object with a
    // small probe container (lib/cloudflare/scanner-namespace.ts).
    "SCAN_ENGINE": "worker",
    // Web Push (VAPID). The public key is what browsers subscribe with; the
    // subject is the contact address push services may write to.
    "VAPID_PUBLIC_KEY": "BJdkLBZFH5nzIA-EaaNWM9jOnEeRYZ4YNYtGXis1WJFe4_HpDFWzVNipsIRv5GPKqvZPvRuxjX67fwsCzdcK-OY",
    "VAPID_SUBJECT": "mailto:mridang.agarwalla@gmail.com",
  },
  // Worker secrets (set via `wrangler secret put`), not plaintext vars. A deploy
  // fails if one is missing, and only these names are typed and loaded from .env.
  // VAPID_PRIVATE_KEY is a secret too but optional (without it notifications are
  // simply off), so it is not listed here.
  "secrets": {
    "required": [
      "GOOGLE_OAUTH_CLIENT_ID",
      "GOOGLE_OAUTH_CLIENT_SECRET",
      "SESSION_SECRET",
      "SCAN_SECRET",
    ],
  },
  // Uploads source maps with the Worker so stack traces in logs and traces
  // point at the original source.
  "upload_source_maps": true,
  // A queue consumer's CPU time is 30 s by default; a job parses scanner output
  // and talks to GitHub for several sites, so give it room (wall time is 15 min).
  "limits": { "cpu_ms": 120000 },
}
