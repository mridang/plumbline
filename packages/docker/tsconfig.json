{
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "preserveConstEnums": true,
    "allowJs": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true
  },
  "references": [{ "path": "../cli" }],
  "include": ["src/**/*"],
  "exclude": ["node_modules", "**/*.spec.ts", "dist", "test"]
}
