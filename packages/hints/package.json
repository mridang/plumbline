{
  "name": "@mridang/webhint-hint-plumbline",
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "prepack": "tsc --build",
    "build": "tsc --build"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/*": "./dist/*"
  },
  "imports": {
    "#hint": {
      "browser": "./dist/browser/hint.js",
      "default": "hint"
    },
    "#net": {
      "types": "./types/net.d.ts",
      "browser": "./dist/browser/net.js",
      "default": "./dist/node/net.js"
    },
    "#tls": {
      "types": "./types/tls.d.ts",
      "browser": "./dist/browser/tls.js",
      "default": "./dist/node/tls.js"
    },
    "#child_process": {
      "types": "./types/child_process.d.ts",
      "browser": "./dist/browser/child-process.js",
      "default": "./dist/node/child-process.js"
    },
    "#crypto": {
      "types": "./types/crypto.d.ts",
      "browser": "./dist/browser/crypto.js",
      "default": "./dist/node/crypto.js"
    },
    "#http": {
      "types": "./types/http.d.ts",
      "browser": "./dist/browser/http.js",
      "default": "./dist/node/http.js"
    },
    "#https": {
      "types": "./types/https.d.ts",
      "browser": "./dist/browser/http.js",
      "default": "./dist/node/https.js"
    },
    "#fs/promises": {
      "types": "./types/fs-promises.d.ts",
      "browser": "./dist/browser/fs.js",
      "default": "./dist/node/fs-promises.js"
    },
    "#os": {
      "types": "./types/os.d.ts",
      "browser": "./dist/browser/fs.js",
      "default": "./dist/node/os.js"
    },
    "#path": {
      "types": "./types/path.d.ts",
      "browser": "./dist/browser/fs.js",
      "default": "./dist/node/path.js"
    },
    "#url": {
      "types": "./types/url.d.ts",
      "browser": "./dist/browser/url.js",
      "default": "./dist/node/url.js"
    }
  },
  "keywords": [
    "webhint",
    "webhint-hint",
    "security-headers",
    "open-graph",
    "seo",
    "llms-txt",
    "robots-txt",
    "agent-readiness"
  ],
  "author": {
    "name": "Mridang Agarwalla",
    "email": "mridang.agarwalla@gmail.com",
    "url": "https://github.com/mridang"
  },
  "files": [
    "dist",
    "configs",
    "types"
  ],
  "license": "Apache-2.0",
  "description": "Extra webhint hints: security headers, Open Graph and SEO, agent readiness, privacy, DNS, TLS and well-known file validators",
  "private": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mridang/plumbline.git",
    "directory": "packages/hints"
  },
  "homepage": "https://github.com/mridang/plumbline",
  "bugs": "https://github.com/mridang/plumbline/issues",
  "peerDependencies": {
    "hint": "^7.1.0"
  },
  "devDependencies": {
    "@hint/parser-html": "^3.1.4",
    "@hint/utils-dom": "^2.2.4",
    "@hint/utils-types": "^1.2.1",
    "hint": "^7.1.13"
  },
  "publishConfig": {
    "access": "public"
  }
}
